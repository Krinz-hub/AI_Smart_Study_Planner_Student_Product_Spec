# ==============================================================================
# AI-Powered Smart Study Planner - Environment Configuration (.env.example)
# ==============================================================================

# Application Environment
APP_ENV=development
APP_NAME=smart-study-planner
DEBUG=true

# Backend Server (FastAPI)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next.js 16)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security & Authentication
SECRET_KEY=supersecret-dev-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# DATABASE ARCHITECTURE (DUAL-DATABASE ISOLATION)
# ==============================================================================

# 1. Product & Identity Store (MongoDB)
# Handles: Users, User Sessions, Academic Profiles, Onboarding Wizard States,
# User Preferences, Settings, and Document 10-Point Summaries Cache.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=smart_study_planner

# 2. Authoritative Knowledge & Relational Database (PostgreSQL + pgvector)
# Handles: Authoritative Learner State, Bayesian Knowledge Tracing (BKT) Posterior Probabilities,
# Free Spaced Repetition Scheduling (FSRS) Memory Half-Life & Stability, Study Tasks & OR-Tools
# Schedules, Exam Mode Plans, Audit Trails, and Document Vector Chunks / Embeddings.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_study_planner
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_study_planner
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smart_study_planner_test

# ==============================================================================
# AI & LLM PROVIDER CONFIGURATION
# ==============================================================================

# Google Gemini AI (Server-Side Non-Authoritative Language Intelligence)
# Used for: Socratic Tutoring, 10-Point Synthesis, Flashcard Generation,
# Active Recall Question Generation, and Grounded Source Explanation.
# The LLM is NEVER authoritative for mastery, deadlines, or scheduling.
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_AI_MODEL=gemini-2.5-flash

# Local LLM Fallback (Ollama / Local Inference)
# If GOOGLE_API_KEY is not set or Google API fails, the backend automatically
# falls back to your local Ollama instance (defaulting to a fast lite model).
LLM_PROVIDER=gemini
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=gemini-2.5-flash
OLLAMA_LITE_MODEL=qwen2.5-coder:1.5b

# Embeddings & Reranker
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# ==============================================================================
# CACHE, STORAGE & AUXILIARY SERVICES
# ==============================================================================

# Cache & Queues (Valkey / Redis)
VALKEY_URL=redis://localhost:6379/0

# Object Storage (SeaweedFS / S3 Compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=study-planner
OBJECT_STORAGE_ACCESS_KEY=dev_access_key
OBJECT_STORAGE_SECRET_KEY=dev_secret_key

# Web Research & Syllabus Crawling (SearXNG)
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080

# ==============================================================================
# LEARNER INTELLIGENCE & ALGORITHM VERSIONING
# ==============================================================================
FSRS_VERSION=fsrs-v4
BKT_VERSION=bkt-v1
PRIORITY_VERSION=priority-v1
PLANNER_VERSION=planner-v1
